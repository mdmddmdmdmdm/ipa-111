<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Local model servers (KoboldCpp, LM Studio, llama.cpp, Ollama) are
         normally plain HTTP on a LAN address such as http://192.168.1.20:5001.
         Android blocks cleartext by default, so those endpoints failed to
         connect. Cleartext is allowed so user-entered local endpoints work;
         HTTPS endpoints are unaffected. -->
    <base-config cleartextTrafficPermitted="true" />
    <!-- Chat WebView serves local Glaze files from a loopback HTTP server. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
